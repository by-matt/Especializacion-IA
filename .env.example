# ==============================================================================
# PLANTILLA DE CONFIGURACIÓN DE ENTORNO (.env)
# ==============================================================================
# INSTRUCCIONES OBLIGATORIAS:
# 1. Copia este archivo con el nombre exacto ".env" en la raíz del proyecto:
#      En Windows (PowerShell): Copy-Item .env.example .env
#      En macOS / Linux:        cp .env.example .env
# 2. Obtén tu API Key gratuita en Google AI Studio:
#      https://aistudio.google.com/app/apikey
# 3. Pega tu API Key real abajo sustituyendo 'tu_clave_aqui'.
# 4. Guarda el archivo. El archivo ".env" jamás se sube a Git (está en .gitignore).
# ==============================================================================

# Llave de API del proveedor de modelo (Google Gemini API)
GEMINI_API_KEY=tu_clave_aqui

# Modelo oficial por defecto (compatible con cuentas nuevas y existentes)
GEMINI_MODEL=gemini-3.8-flash

